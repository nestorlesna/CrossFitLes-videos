  "youtube": {
    "titulo": "Rowing Machine 🔥 Cómo usar el remo ergómetro bien | Gimnasio",
    "tags": [
      "rowing machine",
      "remo ergómetro",
      "remo",
      "rower",
      "cómo usar el remo",
      "técnica de remo",
      "cardio",
