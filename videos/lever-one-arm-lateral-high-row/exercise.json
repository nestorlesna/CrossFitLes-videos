  "youtube": {
    "titulo": "Lever One Arm Lateral High Row 🔥 Remo alto a una mano en palanca | Gimnasio",
    "tags": [
      "lever one arm lateral high row",
      "remo alto a una mano",
      "remo unilateral en palanca",
      "remo alto en máquina",
