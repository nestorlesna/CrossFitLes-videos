  "youtube": {
    "titulo": "Seated Leg Curl 🔥 Cómo usar el femoral sentado bien | Gimnasio",
    "tags": [
      "seated leg curl",
      "curl femoral sentado",
      "femoral sentado",
      "cómo usar el femoral sentado",
      "isquiotibiales",
      "femorales",
      "piernas",
