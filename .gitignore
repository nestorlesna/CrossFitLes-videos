# Skills de HyperFrames: se reinstalan con skills-lock.json
#   npx skills add heygen-com/hyperframes
.agents/
.claude/skills/
.claude/settings.local.json

# Dependencias
node_modules/

# Videos finales (pesados, ~10 MB c/u): se regeneran con
#   node plantilla/make-exercise.mjs <slug> --render
# Se versionan solo la descripción de YouTube y la miniatura.
salida/*.mp4
salida/subidos/**/*.mp4
subidos/**/*.mp4

# Carpetas de trabajo generadas por make-exercise / pose-lab / hyperframes
videos/_poselab/
videos/_pruebas-voz/
videos/*/renders/
videos/*/snapshots/
videos/*/assets/
videos/*/miniatura/
videos/*/.media/
videos/*/.thumbnails/
videos/*/.waveform-cache/
videos/*/.hyperframes/
videos/*/public/

# Sistema / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.log
plantilla/voces-piper/
plantilla/voces-kokoro/

# Videos largos (videos-largos/): se versionan fichas, fuentes (sin fotogramas), miniatura y texto de YouTube
videos-largos/salida/*.mp4
videos-largos/salida/subidos/**/*.mp4
videos-largos/fuentes/*/_frames/
videos-largos/proyectos/_poselab/
videos-largos/proyectos/*/renders/
videos-largos/proyectos/*/snapshots/
videos-largos/proyectos/*/assets/
videos-largos/proyectos/*/miniatura/
videos-largos/proyectos/*/.media/
videos-largos/proyectos/*/.thumbnails/
videos-largos/proyectos/*/.waveform-cache/
videos-largos/proyectos/*/.hyperframes/
videos-largos/proyectos/*/public/
